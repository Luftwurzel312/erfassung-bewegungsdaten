{
  "name": "monatsmeldung",
  "version": "2.1.0",
  "private": true,
  "description": "Geführte Monatsmeldung der Lohn-Bewegungsdaten für Mandanten ohne Lohnwissen, mit LODAS- und SBS-Export",
  "scripts": {
    "build": "python3 build.py",
    "check": "tsc --noEmit -p .",
    "test": "esbuild test/logik.test.ts --bundle --platform=node --outfile=.build/test.js --log-level=warning && node .build/test.js"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "typescript": "^5.6.0"
  }
}
